{
  "name": "Shozee 2.0",
  "user": "ubuntu",
  "install": "./.cursor/cloud/install.sh",
  "start": "./.cursor/cloud/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "./.cursor/cloud/run-api.sh",
      "description": "@showzy/api HTTP server (Hono + better-auth + oRPC/OpenAPI). Health at GET http://localhost:3000/health."
    },
    {
      "name": "worker",
      "command": "./.cursor/cloud/run-worker.sh",
      "description": "@showzy/worker outbox poller and delivery executor."
    }
  ],
  "ports": [
    { "name": "api", "port": 3000 },
    { "name": "postgres", "port": 5432 },
    { "name": "redis", "port": 6379 },
    { "name": "garage", "port": 3900 }
  ]
}
