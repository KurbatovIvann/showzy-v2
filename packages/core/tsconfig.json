{
  "extends": "@showzy/tooling/tsconfig/base.json",
  "compilerOptions": {
    // Runtime subpaths (principal contexts, pipeline, protocols) are
    // server-only and need Node ambient types (AbortSignal, timers). The
    // contract leaf's no-Node guarantee (ADR-0016) is NOT weakened by this:
    // `tsconfig.contract.json` re-checks `src/contract` with `"types": []`
    // in the same `typecheck` script, so an accidental `process`/`Buffer`
    // reference in the leaf still fails CI.
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"]
}
