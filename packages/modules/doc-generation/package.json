{
  "name": "@showzy/doc-generation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Document generation module: system TSX PDF layouts, render jobs, and artifact reads. This package exports actions and events only.",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/index.contract.ts",
    "./suite-coverage": "./src/suite-coverage.ts",
    "./subscriptions": "./src/events/pdf-renderer.ts",
    "./pdf-retry": "./src/services/pdf-retry.ts",
    "./get-artifact": "./src/actions/get-artifact.ts",
    "./resolve-layout": "./src/actions/resolve-layout.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@showzy/core": "workspace:*",
    "@showzy/db": "workspace:*",
    "@showzy/documents": "workspace:*",
    "@showzy/files": "workspace:*",
    "@showzy/module-kit": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "react": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@showzy/tooling": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "19.1.17",
    "eslint": "^10.8.1",
    "testcontainers": "12.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
