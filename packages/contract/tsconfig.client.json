{
  "extends": "@showzy/tooling/tsconfig/base.json",
  "compilerOptions": {
    // The client root ships to Expo bundles (contract.md §2); keeping
    // ambient @types out makes an accidental `process`/`Buffer` reference a
    // compile error. DOM is Fetch + Web Crypto only — not Node. Tests are
    // excluded so they can use the package tsconfig (Node + Vitest).
    "types": [],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/client"],
  "exclude": ["src/client/**/*.test.ts", "src/client/**/*.db.test.ts"]
}
