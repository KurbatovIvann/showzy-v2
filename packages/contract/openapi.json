    "/pricing/resolveProductPrices": {
      "post": {
        "operationId": "pricing.resolveProductPrices",
        "summary": "Resolve effective unit prices for a batch of products or variants in the staff member's active company. When a customer is named, walk the full five-level chain (personal → customer list → group list → company default list → catalog base); when omitted, use only the company default list then base. Inactive lists are skipped. Within a level a variant entry beats a product entry; a higher level always wins over a lower one. The whole batch fails with not-found when any product, named variant, or customer is missing or outside the company.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "variantId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "productId"
                      ]
                    }
                  },
                  "customerId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
