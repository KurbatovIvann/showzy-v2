                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "productId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "variantId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "uuid"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "unitPriceMinor": {
                            "type": "string",
                            "pattern": "^(0|-?[1-9][0-9]*)$"
                          },
                          "currency": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 3
                          },
                          "source": {
                            "enum": [
                              "personal",
                              "customer_price_list",
                              "group_price_list",
                              "default_price_list",
                              "base"
                            ],
                            "type": "string"
                          },
                          "matchLevel": {
                            "enum": [
                              "variant",
                              "product"
                            ],
                            "type": "string"
                          },
                          "sourceIds": {
                            "type": "object",
                            "properties": {
                              "personalPriceId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "priceListId": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "entryId": {
                                "type": "string",
                                "format": "uuid"
                              }
                            }
                          },
                          "resolverVersion": {
                            "const": 1
                          }
                        },
                        "required": [
                          "productId",
                          "variantId",
                          "unitPriceMinor",
                          "currency",
                          "source",
                          "matchLevel",
                          "sourceIds",
                          "resolverVersion"
                        ]
                      }
                    }
