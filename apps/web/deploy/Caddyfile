# Same-origin topology for the web panel (web-T2, ADR-0030): this one origin
# serves the static SPA and forwards /rpc and /api/auth to the API, so CORS
# never activates and SameSite=Lax session cookies work unchanged. Never add
# CORS headers here — cross-origin API access is a stop-condition (SHO-310).
#
# TLS terminates at the platform ingress (Coolify/Traefik); this server
# speaks plain HTTP inside the deployment network.
{
	admin off
	auto_https off
}

:{$WEB_PORT:8080} {
	encode zstd gzip

	# API_UPSTREAM is the API service address inside the deployment network
	# (e.g. http://api:3000). Forward the paths verbatim — the API mounts
	# better-auth at /api/auth and oRPC at /rpc (apps/api/src/http/app.ts).
	handle /rpc/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle /api/auth/* {
		reverse_proxy {$API_UPSTREAM}
	}

	# Everything else is the SPA: real files as-is, unknown paths fall back
	# to index.html so TanStack Router owns client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
