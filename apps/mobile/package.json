{
  "name": "@showzy/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Expo app shell: Unistyles theme transcribed from V1, typed contract client, no product screens (fnd-T48).",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.11",
    "@orpc/contract": "1.15.0",
    "@showzy/contract": "workspace:*",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.33.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-unistyles": "3.2.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@orpc/client": "1.15.0",
    "@showzy/core": "workspace:*",
    "@showzy/tooling": "workspace:*",
    "@types/react": "^19.1.17",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
